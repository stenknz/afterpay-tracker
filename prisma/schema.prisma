generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String        @id @default(cuid())
  name           String?
  email          String        @unique
  hashedPassword String
  avatarPath     String?
  stores         Store[]
  paymentPlans   PaymentPlan[]
  subscriptions  Subscription[]
  utilities      Utility[]
  partnersGiven  PartnerLink[] @relation("shared_by")
  partnersRecv   PartnerLink[] @relation("shared_to")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model PartnerLink {
  id        String   @id @default(cuid())
  sharerId  String
  viewerId  String
  createdAt DateTime @default(now())

  sharer User @relation("shared_by", fields: [sharerId], references: [id], onDelete: Cascade)
  viewer User @relation("shared_to", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([sharerId, viewerId])
}

model Store {
  id           String        @id @default(cuid())
  name         String
  logoPath     String?
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentPlans PaymentPlan[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Vendor {
  id        String        @id @default(cuid())
  name      String        @unique
  logoPath  String?
  plans     PaymentPlan[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model AppSetting {
  id       String @id
  logoPath String?
}

model PaymentPlan {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId           String?
  store             Store?             @relation(fields: [storeId], references: [id], onDelete: SetNull)
  vendorId          String?
  vendor            Vendor?            @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  totalAmount       Float
  installmentAmount Float
  frequency         String             @default("MONTHLY")
  startDate         DateTime
  endDate           DateTime?
  status            String             @default("ACTIVE")
  visibility        String             @default("PRIVATE")
  title             String?
  notes             String?
  archivedAt        DateTime?
  installments      PaymentInstallment[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Subscription {
  id         String                @id @default(cuid())
  userId     String
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  price      Float
  dayOfMonth Int
  billingCycle String               @default("MONTHLY")
  startDate  DateTime               @default(now())
  logoPath   String?
  visibility String                @default("PRIVATE")
  payments   SubscriptionPayment[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
}

model SubscriptionPayment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Float
  paidAt         DateTime
  notes          String?
  createdAt      DateTime     @default(now())

  @@index([subscriptionId])
}

model PaymentInstallment {
  id            String   @id @default(cuid())
  paymentPlanId String
  paymentPlan   PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)
  amount        Float
  dueDate       DateTime
  status        String   @default("PENDING")
  paidAt        DateTime?
  createdAt     DateTime @default(now())
}

model Utility {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  amountDue  Float
  dueDate    DateTime
  status     String           @default("UNPAID")
  visibility String           @default("PRIVATE")
  logoPath   String?
  notes      String?
  payments   UtilityPayment[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model UtilityPayment {
  id        String   @id @default(cuid())
  utilityId String
  utility   Utility  @relation(fields: [utilityId], references: [id], onDelete: Cascade)
  amount    Float
  paidAt    DateTime
  notes     String?
  createdAt DateTime @default(now())

  @@index([utilityId])
}
